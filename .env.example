# Biến dùng cho docker-compose.yml. Copy thành .env (KHÔNG commit file .env).

# API key dùng chung giữa server và các client (>= 16 ký tự)
AUTH_API_KEY=change-me-to-a-long-random-key

# Chuỗi kết nối SQL Server cho Central API (chạy trên máy host, không phải trong compose).
# Lưu ý: container không truy cập được "localhost" của host -> dùng host.docker.internal.
SQL_CONNECTION_STRING=Server=host.docker.internal\SQLEXPRESS;Database=WeighingDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True
