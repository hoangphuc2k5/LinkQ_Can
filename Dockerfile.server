# Central API (Weighing.Server.Api). Build từ thư mục gốc repo:
#   docker build -f Dockerfile.server -t weighing-server:latest .
# Cấu hình runtime (bắt buộc): Auth__ApiKey (>=16 ký tự), ConnectionStrings__Default.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY backend/ ./backend/
RUN dotnet publish backend/Weighing.Server.Api/Weighing.Server.Api.csproj -c Release -o /app/out

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/out .
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://0.0.0.0:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "Weighing.Server.Api.dll"]
